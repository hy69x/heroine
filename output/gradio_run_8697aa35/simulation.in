# LAMMPS Input file generated by Proteus (CHONS Forcefield)

units real
atom_style full
boundary p p p

read_data /home/hy/code/projects/heroine/output/gradio_run_8697aa35/system.data

# Force Field
pair_style lj/cut 10.65
pair_modify mix arithmetic
pair_coeff 1 1 0.066 3.5
pair_coeff 2 2 0.03 2.5
pair_coeff 3 3 0.17 3.12
pair_coeff 4 4 0.17 3.25
pair_coeff 5 5 0.25 3.55

bond_style harmonic
bond_coeff 1 300.0 1.52
bond_coeff 2 300.0 1.4
bond_coeff 3 300.0 1.11
bond_coeff 4 300.0 0.99
bond_coeff 5 300.0 1.53

angle_style harmonic
angle_coeff 1 60.0 110.1
angle_coeff 2 60.0 109.7
angle_coeff 3 60.0 110.0
angle_coeff 4 60.0 108.9
angle_coeff 5 60.0 109.2
angle_coeff 6 60.0 110.4
angle_coeff 7 60.0 109.1
angle_coeff 8 60.0 110.6
angle_coeff 9 60.0 108.8
angle_coeff 10 60.0 108.1
angle_coeff 11 60.0 106.6
angle_coeff 12 60.0 109.8
angle_coeff 13 60.0 109.3
angle_coeff 14 60.0 107.8
angle_coeff 15 60.0 109.5
angle_coeff 16 60.0 109.0
angle_coeff 17 60.0 106.1

dihedral_style harmonic
dihedral_coeff 1 1.0 1 3

neighbor 2.0 bin
neigh_modify delay 0 every 10 check yes

# 1-4 interactions are typically scaled in molecular force fields
special_bonds lj 0.0 0.0 0.5

# Group definitions
group all_atoms type 1 2 3 4 5

# Simulation Protocol
minimize 1.0e-4 1.0e-6 1000 10000
reset_timestep 0

timestep 1.0

# 2. Equilibration / Dynamics
fix 1 all langevin 300.0 300.0 20.0 10818
fix 2 all nve

# Output
dump 1 all custom 200 /home/hy/code/projects/heroine/output/gradio_run_8697aa35/trajectory.dump id mol type x y z
compute rg all gyration
thermo_style custom step c_rg temp epair
thermo 200

# Run
run 50000
