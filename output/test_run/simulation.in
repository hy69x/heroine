# LAMMPS Input file generated by Proteus (CHONS Forcefield)

units real
atom_style full
boundary p p p

read_data /mnt/d_drive/programs/heroine/output/test_run/system.data

# Force Field
pair_style lj/cut 10.65
pair_modify mix arithmetic
pair_coeff 1 1 0.066 3.5
pair_coeff 2 2 0.03 2.5
pair_coeff 3 3 0.17 3.12
pair_coeff 4 4 0.17 3.25
pair_coeff 5 5 0.25 3.55

bond_style harmonic
bond_coeff 1 600.0 1.33
bond_coeff 2 300.0 1.47
bond_coeff 3 600.0 1.26
bond_coeff 4 300.0 1.43
bond_coeff 5 300.0 1.08
bond_coeff 6 300.0 1.04
bond_coeff 7 300.0 1.49
bond_coeff 8 300.0 1.4
bond_coeff 9 300.0 1.41
bond_coeff 10 300.0 1.39
bond_coeff 11 300.0 1.42
bond_coeff 12 300.0 1.11
bond_coeff 13 300.0 1.01

angle_style harmonic
angle_coeff 1 60.0 121.5
angle_coeff 2 60.0 119.9
angle_coeff 3 60.0 118.6
angle_coeff 4 60.0 122.5
angle_coeff 5 60.0 118.7
angle_coeff 6 60.0 118.8
angle_coeff 7 60.0 120.7
angle_coeff 8 60.0 119.4
angle_coeff 9 60.0 120.8
angle_coeff 10 60.0 120.3
angle_coeff 11 60.0 118.9
angle_coeff 12 60.0 110.1
angle_coeff 13 60.0 109.9
angle_coeff 14 60.0 109.5
angle_coeff 15 60.0 108.9
angle_coeff 16 60.0 109.3
angle_coeff 17 60.0 109.1
angle_coeff 18 60.0 119.5
angle_coeff 19 60.0 119.3
angle_coeff 20 60.0 121.1
angle_coeff 21 60.0 125.4
angle_coeff 22 60.0 119.8
angle_coeff 23 60.0 120.6
angle_coeff 24 60.0 118.5
angle_coeff 25 60.0 120.1
angle_coeff 26 60.0 120.0
angle_coeff 27 60.0 118.4
angle_coeff 28 60.0 119.0
angle_coeff 29 60.0 122.0
angle_coeff 30 60.0 121.0
angle_coeff 31 60.0 120.9

dihedral_style harmonic
dihedral_coeff 1 10.0 -1 2
dihedral_coeff 2 1.0 1 3

neighbor 2.0 bin
neigh_modify delay 0 every 10 check yes

# 1-4 interactions are typically scaled in molecular force fields
special_bonds lj 0.0 0.0 0.5

# Group definitions
group all_atoms type 1 2 3 4 5

# Simulation Protocol
minimize 1.0e-4 1.0e-6 1000 10000
reset_timestep 0

timestep 1.0

# 2. Equilibration / Dynamics
fix 1 all langevin 300.0 300.0 20.0 45591
fix 2 all nve

# Output
dump 1 all custom 10 /mnt/d_drive/programs/heroine/output/test_run/trajectory.dump id mol type x y z
compute rg all gyration
thermo_style custom step c_rg temp epair
thermo 10

# Run
run 100
