# LAMMPS Input file generated by Proteus (CHONS Forcefield)

units real
atom_style full
boundary p p p

read_data /home/hy/code/projects/heroine/output/gradio_run_ad79b975/system.data

# Force Field
pair_style lj/cut 10.65
pair_modify mix arithmetic
pair_coeff 1 1 0.066 3.5
pair_coeff 2 2 0.03 2.5
pair_coeff 3 3 0.17 3.12
pair_coeff 4 4 0.17 3.25
pair_coeff 5 5 0.25 3.55

bond_style harmonic
bond_coeff 1 300.0 1.53
bond_coeff 2 300.0 1.54
bond_coeff 3 300.0 1.51
bond_coeff 4 300.0 1.4
bond_coeff 5 300.0 1.41
bond_coeff 6 300.0 1.52
bond_coeff 7 600.0 1.26
bond_coeff 8 300.0 1.11
bond_coeff 9 300.0 1.08
bond_coeff 10 300.0 1.01
bond_coeff 11 300.0 1.49
bond_coeff 12 300.0 1.39
bond_coeff 13 300.0 1.42

angle_style harmonic
angle_coeff 1 60.0 110.6
angle_coeff 2 60.0 110.3
angle_coeff 3 60.0 108.8
angle_coeff 4 60.0 108.9
angle_coeff 5 60.0 107.8
angle_coeff 6 60.0 110.0
angle_coeff 7 60.0 107.5
angle_coeff 8 60.0 111.6
angle_coeff 9 60.0 108.3
angle_coeff 10 60.0 109.2
angle_coeff 11 60.0 110.5
angle_coeff 12 60.0 110.8
angle_coeff 13 60.0 110.4
angle_coeff 14 60.0 108.7
angle_coeff 15 60.0 112.1
angle_coeff 16 60.0 109.9
angle_coeff 17 60.0 109.6
angle_coeff 18 60.0 106.5
angle_coeff 19 60.0 120.6
angle_coeff 20 60.0 120.1
angle_coeff 21 60.0 119.3
angle_coeff 22 60.0 120.4
angle_coeff 23 60.0 119.2
angle_coeff 24 60.0 120.5
angle_coeff 25 60.0 119.1
angle_coeff 26 60.0 119.0
angle_coeff 27 60.0 120.8
angle_coeff 28 60.0 120.3
angle_coeff 29 60.0 110.1
angle_coeff 30 60.0 111.2
angle_coeff 31 60.0 107.1
angle_coeff 32 60.0 106.6
angle_coeff 33 60.0 111.0
angle_coeff 34 60.0 107.9
angle_coeff 35 60.0 119.7
angle_coeff 36 60.0 120.7
angle_coeff 37 60.0 119.5
angle_coeff 38 60.0 120.9
angle_coeff 39 60.0 109.5
angle_coeff 40 60.0 109.3
angle_coeff 41 60.0 109.1
angle_coeff 42 60.0 121.1
angle_coeff 43 60.0 125.4
angle_coeff 44 60.0 119.8
angle_coeff 45 60.0 119.4
angle_coeff 46 60.0 118.5
angle_coeff 47 60.0 120.0
angle_coeff 48 60.0 119.9
angle_coeff 49 60.0 118.4
angle_coeff 50 60.0 122.0
angle_coeff 51 60.0 121.0
angle_coeff 52 60.0 118.9

dihedral_style harmonic
dihedral_coeff 1 1.0 1 3

neighbor 2.0 bin
neigh_modify delay 0 every 10 check yes

# 1-4 interactions are typically scaled in molecular force fields
special_bonds lj 0.0 0.0 0.5

# Group definitions
group all_atoms type 1 2 3 4 5

# Simulation Protocol
minimize 1.0e-4 1.0e-6 1000 10000
reset_timestep 0

timestep 1.0

# 2. Equilibration / Dynamics
fix 1 all langevin 300.0 300.0 20.0 2155
fix 2 all nve

# Output
dump 1 all custom 200 /home/hy/code/projects/heroine/output/gradio_run_ad79b975/trajectory.dump id mol type x y z
compute rg all gyration
thermo_style custom step c_rg temp epair
thermo 200

# Run
run 50000
